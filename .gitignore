# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
# **/*.usd
# **/*.usda
# **/*.usdc
# **/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb
**/*.orig

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
datasets

# Tests
tests/
/source/cyclo_lab/test/

# Keep machine-local environment and task packages out of Git.
/scripts/sim2real/imitation_learning/environments/local/
/scripts/sim2real/imitation_learning/tasks/local/
# Track only the portable task catalog and its template here.
/scripts/sim2real/imitation_learning/tasks/*
!/scripts/sim2real/imitation_learning/tasks/catalog/
!/scripts/sim2real/imitation_learning/tasks/README.md
!/scripts/sim2real/imitation_learning/tasks/task_template.json

# Docker history
.isaac-lab-docker-history
/.usd_share/

# Third-party dependency worktrees are managed as submodules. Ignore arbitrary
# local folders under third_party, but keep submodule roots visible to Git.
third_party/*
!third_party/IsaacLab
!third_party/IsaacLab-Arena
!third_party/ai_sapiens
!third_party/zenoh_ros2_sdk

# Zenoh ROS2 SDK message cache mounted into Docker
docker/zenoh_cache/
/tmp/

# Local generated artifacts
/captures/
/.runtime/
